local ANIM_SLOTS = {
    "idle", "walk", "run", "jump", "fall",
    "climb", "sit", "toolnone", "toolslash",
    "toollunge", "swim", "swimidle",
}

local function applyDisguise(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then
        notify("Disfarce", "Jogador sem personagem", Color3.fromRGB(180, 30, 30)); return
    end

    -- Salva original ANTES do primeiro disfarce
    if not disguiseActive then
        originalAppearance = {}
        if player.Character then
            for _, obj in pairs(player.Character:GetChildren()) do
                if obj:IsA("Accessory") or obj:IsA("Shirt") or obj:IsA("Pants")
                    or obj:IsA("BodyColors") or obj:IsA("ShirtGraphic") then
                    originalAppearance[#originalAppearance + 1] = obj:Clone()
                end
            end
            -- Salva animações originais
            local myAnimate = player.Character:FindFirstChild("Animate")
            if myAnimate then
                originalAppearance._animateClone = myAnimate:Clone()
            end
        end
    end

    -- Remove roupa atual
    for _, obj in pairs(player.Character:GetChildren()) do
        if obj:IsA("Accessory") or obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("ShirtGraphic") then
            obj:Destroy()
        end
    end

    -- Copia roupas e acessórios
    local copied = 0
    for _, obj in pairs(targetPlayer.Character:GetChildren()) do
        if obj:IsA("Accessory") or obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("ShirtGraphic") then
            obj:Clone().Parent = player.Character; copied += 1
        end
    end

    -- Copia cores de pele
    local tCol = targetPlayer.Character:FindFirstChildOfClass("BodyColors")
    local mCol = player.Character:FindFirstChildOfClass("BodyColors")
    if tCol and mCol then
        mCol.HeadColor3     = tCol.HeadColor3
        mCol.TorsoColor3    = tCol.TorsoColor3
        mCol.LeftArmColor3  = tCol.LeftArmColor3
        mCol.RightArmColor3 = tCol.RightArmColor3
        mCol.LeftLegColor3  = tCol.LeftLegColor3
        mCol.RightLegColor3 = tCol.RightLegColor3
    end

    -- Copia face
    local tHead = targetPlayer.Character:FindFirstChild("Head")
    local mHead = player.Character:FindFirstChild("Head")
    if tHead and mHead then
        local tFace = tHead:FindFirstChildOfClass("Decal")
        local mFace = mHead:FindFirstChildOfClass("Decal")
        if tFace and mFace then mFace.Texture = tFace.Texture end
    end

    -- Copia animações (andar, correr, pular, etc.)
    local targetAnimate = targetPlayer.Character:FindFirstChild("Animate")
    local myAnimate = player.Character:FindFirstChild("Animate")
    local animsCopied = 0

    if targetAnimate and myAnimate then
        for _, slotName in ipairs(ANIM_SLOTS) do
            local tSlot = targetAnimate:FindFirstChild(slotName)
            local mSlot = myAnimate:FindFirstChild(slotName)
            if tSlot and mSlot then
                -- Remove animações atuais do slot
                for _, child in pairs(mSlot:GetChildren()) do
                    child:Destroy()
                end
                -- Copia as do alvo
                for _, child in pairs(tSlot:GetChildren()) do
                    child:Clone().Parent = mSlot
                    animsCopied += 1
                end
            end
        end
        -- Reinicia o Animate para carregar os novos IDs
        myAnimate.Disabled = true
        task.wait(0.1)
        myAnimate.Disabled = false
        notify("Disfarce",
            string.format("Disfarçado como %s — %d roupas + %d animações", targetPlayer.Name, copied, animsCopied),
            Color3.fromRGB(200, 150, 30))
    else
        notify("Disfarce",
            string.format("Disfarçado como %s — %d roupas (sem Animate)", targetPlayer.Name, copied),
            Color3.fromRGB(200, 150, 30))
    end

    disguiseActive = true
    disguiseLabel.Text = "🎭 " .. targetPlayer.Name
end

