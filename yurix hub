local function notify(title, msg, color)
    color = color or Color3.fromRGB(180, 30, 30)
    local nf = Instance.new("Frame", notifHolder)
    nf.Size = UDim2.new(1, 0, 0, 60); nf.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
    nf.BackgroundTransparency = 0.1; nf.BorderSizePixel = 0; nf.ZIndex = 100
    Instance.new("UICorner", nf).CornerRadius = UDim.new(0, 10)
    local nfStroke = Instance.new("UIStroke", nf); nfStroke.Color = color; nfStroke.Thickness = 1.5
    local bar = Instance.new("Frame", nf); bar.Size = UDim2.new(0, 4, 1, 0)
    bar.BackgroundColor3 = color; bar.BorderSizePixel = 0; bar.ZIndex = 101
    Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 4)
    local t1 = Instance.new("TextLabel", nf); t1.Size = UDim2.new(1, -20, 0, 22); t1.Position = UDim2.new(0, 14, 0, 6)
    t1.Text = title; t1.Font = Enum.Font.GothamBold; t1.TextSize = 13
    t1.TextColor3 = Color3.new(1, 1, 1); t1.BackgroundTransparency = 1
    t1.TextXAlignment = Enum.TextXAlignment.Left; t1.ZIndex = 101
    local t2 = Instance.new("TextLabel", nf); t2.Size = UDim2.new(1, -20, 0, 18); t2.Position = UDim2.new(0, 14, 0, 30)
    t2.Text = msg; t2.Font = Enum.Font.Gotham; t2.TextSize = 11
    t2.TextColor3 = Color3.fromRGB(180, 180, 200); t2.BackgroundTransparency = 1
    t2.TextXAlignment = Enum.TextXAlignment.Left; t2.ZIndex = 101
    nf.Position = UDim2.new(1, 20, 0, 0)
    TweenService:Create(nf, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 0, 0)
    }):Play()
    table.insert(actionLog, 1, {time = os.date("%H:%M:%S"), text = title .. ": " .. msg})
    if #actionLog > 50 then table.remove(actionLog) end
    task.delay(3.5, function()
        TweenService:Create(nf, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 20, 0, 0), BackgroundTransparency = 1
        }):Play()
        task.wait(0.35); nf:Destroy()
    end)
end

local function createSection(parent, title)
    local sec = Instance.new("Frame", parent); sec.Size = UDim2.new(1, 0, 0, 26); sec.BackgroundTransparency = 1
    local line = Instance.new("Frame", sec); line.Size = UDim2.new(1, 0, 0, 1); line.Position = UDim2.new(0, 0, 0.5, 0)
    line.BackgroundColor3 = Color3.fromRGB(50, 50, 60); line.BorderSizePixel = 0
    local lbl = Instance.new("TextLabel", sec); lbl.Size = UDim2.new(0, 0, 1, 0); lbl.AutomaticSize = Enum.AutomaticSize.X
    lbl.Text = "  " .. title .. "  "; lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 10
    lbl.TextColor3 = Color3.fromRGB(160, 160, 180); lbl.BackgroundColor3 = Color3.fromRGB(10, 10, 14)
    lbl.BackgroundTransparency = 0; lbl.ZIndex = 2
