local function openMenu()
    menuOpen = true
    miniBar.Visible = false
    main.Visible = true; shadow.Visible = true
    main.Size = UDim2.fromScale(0.08, 0.08)
    main.BackgroundTransparency = 1; canvasGroup.GroupTransparency = 1
    TweenService:Create(main, TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {Size = UDim2.fromScale(0.35, 0.8), BackgroundTransparency = 0}):Play()
    TweenService:Create(canvasGroup, TweenInfo.new(0.45), {GroupTransparency = 0}):Play()
    TweenService:Create(shadow, TweenInfo.new(0.4), {ImageTransparency = 0.5}):Play()
end

local function closeMenu()
    menuOpen = false
    TweenService:Create(main, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In),
        {Size = UDim2.fromScale(0.08, 0.08), BackgroundTransparency = 1}):Play()
    TweenService:Create(canvasGroup, TweenInfo.new(0.2), {GroupTransparency = 1}):Play()
    TweenService:Create(shadow, TweenInfo.new(0.3), {ImageTransparency = 1}):Play()
    task.wait(0.45)
    if not menuOpen then main.Visible = false; shadow.Visible = false end
end

local function toggleMenu()
    if menuOpen then closeMenu() else openMenu() end
end

