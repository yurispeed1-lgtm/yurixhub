local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 1.5; FOVCircle.Filled = false

local espLabels = {}
local gradAngle = 0
local glowPulse = 0

RS.RenderStepped:Connect(function()
    hue = (hue + 0.004) % 1
    local baseHue = (Config.Theme + hue) % 1
    local color = Color3.fromHSV(baseHue, 0.9, 1)
    local colorDark = Color3.fromHSV(baseHue, 0.7, 0.3)
    local colorMid = Color3.fromHSV((baseHue + 0.15) % 1, 0.8, 0.2)

    stroke.Color = color; headerTitle.TextColor3 = color; headerDivider.BackgroundColor3 = color
    miniStroke.Color = color; miniTitle.TextColor3 = color
    activeBarGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, color),
        ColorSequenceKeypoint.new(1, Color3.fromHSV((baseHue + 0.3) % 1, 0.8, 1)),
    })

    gradAngle = (gradAngle + 0.3) % 360
    bgGradient.Rotation = gradAngle
    bgGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, colorDark),
        ColorSequenceKeypoint.new(0.5, colorMid),
        ColorSequenceKeypoint.new(1, Color3.fromHSV((baseHue + 0.5) % 1, 0.6, 0.18)),
    })

    for _, star in ipairs(stars) do
        star.x += star.speedX; star.y += star.speedY
        if star.x > 1.05 then star.x = -0.05 elseif star.x < -0.05 then star.x = 1.05 end
        if star.y > 1.05 then star.y = -0.05 elseif star.y < -0.05 then star.y = 1.05 end
        star.pulse += star.pulseSpeed
        local brightness = 0.5 + 0.5 * math.sin(star.pulse)
        star.obj.Position = UDim2.fromScale(star.x, star.y)
        star.obj.BackgroundColor3 = Color3.fromHSV((baseHue + star.hueOffset) % 1, 0.6, 1)
        star.obj.BackgroundTransparency = 0.2 + (1 - brightness) * 0.6
        local s = star.size * (0.8 + brightness * 0.4); star.obj.Size = UDim2.fromOffset(s, s)
    end

    for _, sl in ipairs(scanLines) do
        sl.y += sl.speed; if sl.y > 1.02 then sl.y = -0.02 end
        sl.obj.Position = UDim2.fromScale(0, sl.y)
        sl.grad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromHSV(baseHue, 0.3, 1)),
            ColorSequenceKeypoint.new(0.5, Color3.fromHSV((baseHue + 0.1) % 1, 0.5, 1)),
            ColorSequenceKeypoint.new(1, Color3.fromHSV(baseHue, 0.3, 1)),
        })
    end

    glowPulse = (glowPulse + 0.02) % (math.pi * 2)
    local pAlpha = 0.5 + 0.2 * math.sin(glowPulse)
    glow1.ImageColor3 = color; glow1.ImageTransparency = pAlpha
    glow2.ImageColor3 = Color3.fromHSV((baseHue + 0.5) % 1, 0.8, 1); glow2.ImageTransparency = pAlpha + 0.1

    headerGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(20, 20, 28)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(12, 12, 16)),
    })

    updateCrosshair()

    if Config.Noclip and player.Character then
        for _, v in pairs(player.Character:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
    end

    if Config.FullBright then Lighting.Ambient = Color3.new(1,1,1); Lighting.GlobalShadows = false end

    if Config.GodMode and player.Character and player.Character:FindFirstChild("Humanoid") then
        if player.Character.Humanoid.Health < player.Character.Humanoid.MaxHealth then
            player.Character.Humanoid.Health = player.Character.Humanoid.MaxHealth
        end
    end

    FOVCircle.Visible = Config.Aimbot and Config.ShowFOV
    FOVCircle.Radius = Config.FOV; FOVCircle.Color = color
    FOVCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)

    if Config.Aimbot then
        local target = nil; local dist = Config.FOV
        local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= player and p.Character and p.Character:FindFirstChild(Config.AimbotBone)
                and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                local pos, vis = cam:WorldToViewportPoint(p.Character[Config.AimbotBone].Position)
                if vis then
                    local m = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if m < dist then dist = m; target = p.Character[Config.AimbotBone] end
                end
            end
        end
        if target then cam.CFrame = CFrame.new(cam.CFrame.Position, target.Position) end
    end

    for pid, lbl in pairs(espLabels) do lbl:Remove(); espLabels[pid] = nil end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = p.Character.HumanoidRootPart
            if Config.Hitbox then
                hrp.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
                hrp.Transparency = 0.8; hrp.CanCollide = false; hrp.Massless = true
            else hrp.Size = Vector3.new(2, 2, 1); hrp.Transparency = 0 end
            if Config.ESP then
                if not p.Character:FindFirstChild("YurixHighlight") then
                    local h = Instance.new("Highlight", p.Character); h.Name = "YurixHighlight"
                    h.FillColor = color; h.OutlineColor = color
                else p.Character.YurixHighlight.FillColor = color; p.Character.YurixHighlight.OutlineColor = color end
            else if p.Character:FindFirstChild("YurixHighlight") then p.Character.YurixHighlight:Destroy() end end
            if Config.ESPNames or Config.ESPDistance then
                local headPos = p.Character:FindFirstChild("Head")
                if headPos then
                    local pos, vis = cam:WorldToViewportPoint(headPos.Position + Vector3.new(0, 2.5, 0))
                    if vis then
                        local dist2 = math.floor((hrp.Position - (player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character.HumanoidRootPart.Position or hrp.Position)).Magnitude)
                        local txt = ""
                        if Config.ESPNames then txt = p.Name end
                        if Config.ESPDistance then txt = txt .. (txt ~= "" and "\n" or "") .. dist2 .. "m" end
                        local label = Drawing.new("Text"); label.Text = txt
                        label.Position = Vector2.new(pos.X, pos.Y); label.Size = 14
                        label.Color = color; label.Outline = true; label.OutlineColor = Color3.new(0,0,0)
                        label.Center = true; label.Visible = true; espLabels[p.UserId] = label
                    end
                end
            end
        end
    end
end)

UIS.InputBegan:Connect(function(i, g)
    if not g and i.KeyCode == Config.MenuKey then toggleMenu() end
end)

task.delay(0.5, function()
    notify("Yurix Hub V5.0", "Painel carregado! Pressione P para abrir.", Color3.fromRGB(150, 30, 30))
    buildPlayerList()
    buildDisguisePlayerList()
end)
